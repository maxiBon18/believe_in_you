{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(fvm dart analyze:*)",
      "Bash(fvm dart format:*)",
      "Bash(fvm dart run build_runner:*)",
      "Bash(fvm flutter test:*)",
      "Bash(fvm flutter pub get:*)",
      "Bash(fvm flutter pub outdated:*)",
      "Bash(fvm flutter doctor:*)",
      "Bash(fvm --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(find lib:*)",
      "Bash(find test:*)",
      "Bash(find integration_test:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(fvm flutter pub add:*)",
      "Bash(fvm flutter pub remove:*)",
      "Bash(fvm flutter build:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
